MONGO_URI=your_mongodb_uri
JWT_SECRET=your_secret
PORT=5001

# Twilio SMS OTP — https://www.twilio.com (free tier $15 credit)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890_your_twilio_number

# Optional: show OTP in API response when SMS fails (auto on in development)
CONNEX_OTP_IN_RESPONSE=true
